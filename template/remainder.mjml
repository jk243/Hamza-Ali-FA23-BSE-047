<mjml>
  <mj-head>
    <mj-font name="Source Sans 3" href="https://fonts.googleapis.com/css?family=Source+Sans+3"></mj-font>

    <mj-attributes>
      <mj-all font-family="'Source Sans 3', Helvetica, Arial, sans-serif"></mj-all>
      <mj-text
        font-weight="400"
        font-size="18px"
        color="#EAF2FF"
        line-height="26px"
        align="center"
        padding="0px"
      ></mj-text>
    </mj-attributes>

    <mj-style>
      .aa-text a {
        text-decoration: underline;
        color: unset;
      }

      .aa-info {
        border-radius: 14px;
      }

      .aa-btn td {
        box-shadow: inset 0 0 1px #fff;
      }

      .aa-btn p,
      .aa-btn a {
        background-color: transparent !important;
      }

      .aa-btn-blue:hover td {
        background: #174EA6 !important;
      }

      .aa-btn-red:hover td {
        background: #B91C1C !important;
      }
    </mj-style>
  </mj-head>

  <mj-body background-color="#0F172A">

    <!-- Webview -->
    <mj-section background-color="#0F172A" padding="16px 0">
      <mj-column>
        <mj-text
          color="#94A3B8"
          font-size="14px"
          css-class="aa-text"
          line-height="24px"
        >
          {{webviewText}}
        </mj-text>
      </mj-column>
    </mj-section>

    <!-- Banner -->
    <mj-section background-color="#0F172A" padding="0">
      <mj-column padding="0">
        <mj-image
          padding="0"
          src="https://github.com/ricfreire/mautic-theme-appointmentalert/blob/main/assets/calendar.png?raw=true"
        />
      </mj-column>
    </mj-section>

    <!-- Main Card -->
    <mj-section
      background-color="#1E293B"
      border-radius="24px 24px 0 0"
      padding="35px 40px"
    >
      <mj-column>

        <mj-text
          padding="0"
          font-size="28px"
          font-weight="700"
          line-height="34px"
          color="#FFFFFF"
        >
          {{greeting}}
        </mj-text>

        <mj-spacer height="28px"/>

        <mj-text color="#CBD5E1" css-class="aa-text">
          {{introText}}
        </mj-text>

        <mj-spacer height="30px"/>

        <mj-text color="#FFFFFF" css-class="aa-text">
          <b>Task:</b> {{taskTitle}}
        </mj-text>

        <mj-spacer height="14px"/>

        <mj-text color="#FFFFFF" css-class="aa-text">
          <b>Deadline:</b> {{dueDate}}
        </mj-text>

        <mj-spacer height="14px"/>

        <mj-text color="#FFFFFF" css-class="aa-text">
          <b>Status:</b> {{taskStatus}}
        </mj-text>

        <mj-spacer height="30px"/>

        <mj-text
          padding="16px"
          container-background-color="#334155"
          color="#F8FAFC"
          css-class="aa-text aa-info"
        >
          {{reminderMessage}}
        </mj-text>

      </mj-column>
    </mj-section>

    <!-- Buttons -->
    <mj-section
      background-color="#1E293B"
      border-radius="0 0 24px 24px"
      padding="0 40px 40px"
    >

      <mj-column width="48%">
        <mj-button
          href="{{taskLink}}"
          background-color="#2563EB"
          border-radius="12px"
          border="1px solid #2563EB"
          font-size="18px"
          width="100%"
          css-class="aa-btn aa-btn-blue"
        >
          View Task
        </mj-button>
      </mj-column>

      <mj-column width="4%"></mj-column>

      <mj-column width="48%">
        <mj-button
          href="{{taskLink}}"
          background-color="#DC2626"
          border-radius="12px"
          border="1px solid #DC2626"
          font-size="18px"
          width="100%"
          css-class="aa-btn aa-btn-red"
        >
          Mark Complete
        </mj-button>
      </mj-column>

    </mj-section>

    <!-- Footer -->
    <mj-section background-color="#0F172A" padding="20px 0 40px">
      <mj-column>
        <mj-text
          color="#94A3B8"
          font-size="14px"
          css-class="aa-text"
          line-height="24px"
        >
          Sent automatically by your Task Reminder System.
        </mj-text>
      </mj-column>
    </mj-section>

  </mj-body>
</mjml><mjml>
  <mj-head>
    <mj-font name="Source Sans 3" href="https://fonts.googleapis.com/css2?family=Source+Sans+3:wght@400;600;700&display=swap" />
    <mj-attributes>
      <mj-all font-family="'Source Sans 3', Helvetica, Arial, sans-serif" />
      <mj-text
        font-weight="400"
        font-size="16px"
        color="#EAF2FF"
        line-height="26px"
        align="left"
        padding="0px"
      />
      <mj-button font-size="16px" font-weight="600" />
    </mj-attributes>
    <mj-style>
      .aa-text a {
        text-decoration: underline;
        color: inherit;
      }
      .aa-info {
        border-radius: 14px !important;
      }
    </mj-style>
  </mj-head>

  <mj-body background-color="#0F172A" width="600px">
    <!-- Webview -->
    <mj-section background-color="#0F172A" padding="16px 24px">
      <mj-column>
        <mj-text color="#94A3B8" font-size="13px" align="center" css-class="aa-text">
          {{webviewText}}
        </mj-text>
      </mj-column>
    </mj-section>

    <!-- Main Card Top -->
    <mj-section background-color="#1E293B" border-radius="24px 24px 0 0" padding="36px 40px 20px">
      <mj-column>
        <mj-text font-size="26px" font-weight="700" line-height="34px" color="#FFFFFF" padding="0">
          {{greeting}}
        </mj-text>
        <mj-spacer height="20px" />
        <mj-text color="#CBD5E1" font-size="16px" css-class="aa-text">
          {{introText}}
        </mj-text>
        <mj-spacer height="24px" />
        <mj-text color="#FFFFFF" font-size="16px">
          <b>Task:</b> {{taskTitle}}
        </mj-text>
        <mj-spacer height="10px" />
        <mj-text color="#FFFFFF" font-size="16px">
          <b>Deadline:</b> {{dueDate}}
        </mj-text>
        <mj-spacer height="10px" />
        <mj-text color="#FFFFFF" font-size="16px">
          <b>Status:</b> {{taskStatus}}
        </mj-text>
        <mj-spacer height="24px" />
        <mj-text
          padding="16px"
          container-background-color="#334155"
          color="#F8FAFC"
          font-size="15px"
          css-class="aa-text aa-info"
        >
          {{reminderMessage}}
        </mj-text>
      </mj-column>
    </mj-section>

    <!-- Buttons -->
    <mj-section background-color="#1E293B" border-radius="0 0 24px 24px" padding="12px 40px 36px">
      <mj-column width="48%">
        <mj-button
          href="{{taskLink}}"
          background-color="#2563EB"
          color="#FFFFFF"
          border-radius="12px"
          width="100%"
          inner-padding="14px 10px"
        >
          View Task
        </mj-button>
      </mj-column>
      <mj-column width="4%" />
      <mj-column width="48%">
        <mj-button
          href="{{taskLink}}"
          background-color="#DC2626"
          color="#FFFFFF"
          border-radius="12px"
          width="100%"
          inner-padding="14px 10px"
        >
          Mark Complete
        </mj-button>
      </mj-column>
    </mj-section>

    <!-- Footer -->
    <mj-section background-color="#0F172A" padding="20px 24px 40px">
      <mj-column>
        <mj-text color="#94A3B8" font-size="13px" align="center" line-height="22px">
          Sent automatically by {{senderName}}{{#if companyName}} · {{companyName}}{{/if}}
        </mj-text>
      </mj-column>
    </mj-section>
  </mj-body>
</mjml>